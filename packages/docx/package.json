{
  "name": "@docen/docx",
  "version": "0.5.5",
  "description": "DOCX editor and converter powered by @office-open/docx with Tiptap editing layer, supporting bidirectional conversion between DOCX, HTML, and Markdown",
  "keywords": [
    "converter",
    "docen",
    "docx",
    "editor",
    "html",
    "markdown",
    "microsoft-word",
    "office",
    "rich-text",
    "tiptap",
    "typescript",
    "wysiwyg"
  ],
  "homepage": "https://github.com/DemoMacro/docen#readme",
  "bugs": {
    "url": "https://github.com/DemoMacro/docen/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Demo Macro",
    "email": "abc@imst.xyz",
    "url": "https://www.demomacro.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemoMacro/docen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "import": "./dist/core.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.mts",
      "import": "./dist/editor.mjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.mts",
      "import": "./dist/layout/index.mjs"
    },
    "./converters/*": {
      "types": "./dist/converters/*.d.mts",
      "import": "./dist/converters/*.mjs"
    },
    "./extensions/*": {
      "types": "./dist/extensions/*.d.mts",
      "import": "./dist/extensions/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@office-open/core": "0.12.3",
    "@office-open/docx": "0.12.3",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-blockquote": "3.29.2",
    "@tiptap/extension-code-block-lowlight": "3.29.2",
    "@tiptap/extension-details": "3.29.2",
    "@tiptap/extension-emoji": "3.29.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-mathematics": "3.29.2",
    "@tiptap/extension-mention": "3.29.2",
    "@tiptap/markdown": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "image-meta": "0.2.2",
    "linkedom": "0.18.13",
    "lowlight": "3.3.0"
  }
}
